# Copy to .env and fill in. .env is git-ignored, and it's read only when you pass
# --env-file: there is no directory search. A variable already exported wins.

# From Keys and credentials in your Intuit app. Sandbox uses the Development pair.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# sandbox (default) or production. Keep production in its own file.
QBO_ENV=sandbox

# Where the store key lives: keychain (macOS, default), env, or none.
# With env, set QBO_TOKEN_KEY to 44 characters of base64 or 64 of hex.
# QBO_TOKEN_KEY_SOURCE=keychain
# QBO_TOKEN_KEY=

# Optional. The registry, in place of --entities. Production names it here.
# QBO_ENTITIES_FILE=

# Optional. The store defaults to ~/.local/state/qbo-multicompany-mcp, under
# XDG_STATE_HOME if that's set, and refuses a git working copy or a cloud-sync folder.
# QBO_TOKEN_STORE=

# Optional. Production needs an https forwarder: see docs/production.md.
# QBO_REDIRECT_URI=

# Opt-in file downloads: see docs/design.md. Both are needed.
# QBO_ALLOW_DOCUMENTS=1
# QBO_ATTACHMENT_HOSTS=
